#!/usr/bin/env bash
# Harness for examples/notes-service. Launch, doctor, HTTP, and CLI all use the
# run recorded in /tmp/effect-actions-verify-$RUN_ID/run.env. Cleanup deletes
# that directory and the server process it names. It does not delete EVIDENCE_DIR.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"

die() {
  printf 'notes-verify: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage:
  notes-verify launch [--run ID] [--evidence DIR]
  notes-verify doctor [--run ID]
  notes-verify http [--run ID] [--token ada|grace|reader|none] [--evidence NAME] METHOD PATH [--header 'Name: value']... [--data JSON]
  notes-verify cli [--run ID] [--token ada|grace|reader|none] [--expect-exit N] [--evidence NAME] [--stdin-text TEXT | --stdin-file FILE] -- COMMAND...
  notes-verify cleanup [--run ID]

State: /tmp/effect-actions-verify-$RUN_ID/run.env
Evidence defaults to $NOTES_VERIFY_EVIDENCE or $HOME/.cache/effect-actions-verify/$RUN_ID
Pass NOTES_VERIFY_RUN or --run after launch. launch prints an export line.
EOF
}

require_node() {
  command -v node >/dev/null 2>&1 || die "node is not on PATH"
  node -e '
    const [major, minor] = process.versions.node.split(".").map(Number)
    const ok = (major === 22 && minor >= 18) || (major === 24 && minor >= 11) || major >= 26
    if (!ok) {
      console.error("node " + process.versions.node + " does not satisfy devEngines.runtime ^22.18.0 || ^24.11.0 || >=26.0.0")
      process.exit(1)
    }
  '
  [[ -x "$ROOT/node_modules/.bin/tsx" || -d "$ROOT/node_modules/tsx" ]] || die "dependencies are missing in $ROOT; run vp install (or pnpm install) from the repository root"
}

take_run_flag() {
  RUN_ID="${NOTES_VERIFY_RUN:-}"
  local -a kept=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run)
        [[ $# -ge 2 ]] || die "--run needs an id"
        RUN_ID="$2"
        shift 2
        ;;
      *)
        kept+=("$1")
        shift
        ;;
    esac
  done
  ARGS=("${kept[@]+"${kept[@]}"}")
}

load_run() {
  [[ -n "${RUN_ID:-}" ]] || die "set NOTES_VERIFY_RUN or pass --run (launch prints it)"
  STATE_DIR="/tmp/effect-actions-verify-$RUN_ID"
  [[ -f "$STATE_DIR/run.env" ]] || die "no run env at $STATE_DIR/run.env"
  # shellcheck disable=SC1090
  set -a
  source "$STATE_DIR/run.env"
  set +a
  [[ -n "${EVIDENCE_DIR:-}" && -n "${PID:-}" && -n "${PORT:-}" && -n "${NOTES_URL:-}" ]] || die "run env is incomplete"
}

free_port() {
  node -e 'const net = require("node:net"); const server = net.createServer(); server.listen(0, "127.0.0.1", () => { process.stdout.write(String(server.address().port)); server.close(); });'
}

cmd_launch() {
  require_node
  local evidence=""
  RUN_ID="${NOTES_VERIFY_RUN:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run)
        RUN_ID="$2"
        shift 2
        ;;
      --evidence)
        evidence="$2"
        shift 2
        ;;
      *)
        die "unknown launch argument: $1"
        ;;
    esac
  done
  if [[ -z "$RUN_ID" ]]; then
    RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  fi
  STATE_DIR="/tmp/effect-actions-verify-$RUN_ID"
  if [[ -z "$evidence" ]]; then
    evidence="${NOTES_VERIFY_EVIDENCE:-$HOME/.cache/effect-actions-verify/$RUN_ID}"
  fi
  EVIDENCE_DIR="$evidence"
  [[ ! -e "$STATE_DIR" ]] || die "state directory already exists: $STATE_DIR"
  mkdir -p "$STATE_DIR" "$EVIDENCE_DIR"
  PORT="$(free_port)"
  [[ "$PORT" =~ ^[0-9]+$ ]] || die "could not choose a port"
  HOST="127.0.0.1"
  NOTES_URL="http://$HOST:$PORT"
  PUBLIC_URL="$NOTES_URL"
  local logfile="$EVIDENCE_DIR/server.log"
  local caller_pwd
  caller_pwd="$(pwd)"
  cd "$ROOT"
  # Background node itself so PID is the server, not a shell wrapper.
  HOST="$HOST" PORT="$PORT" PUBLIC_URL="$PUBLIC_URL" \
    node --import tsx examples/notes-service/src/server.ts >"$logfile" 2>&1 &
  PID="$!"
  cd "$caller_pwd"
  cat >"$STATE_DIR/run.env" <<EOF
RUN_ID=$RUN_ID
STATE_DIR=$STATE_DIR
EVIDENCE_DIR=$EVIDENCE_DIR
PID=$PID
PORT=$PORT
HOST=$HOST
NOTES_URL=$NOTES_URL
PUBLIC_URL=$PUBLIC_URL
REPO_ROOT=$ROOT
EOF
  local ready=0
  local i
  for i in $(seq 1 50); do
    if ! kill -0 "$PID" 2>/dev/null; then
      break
    fi
    if grep -q "Listening on $NOTES_URL" "$logfile"; then
      local body
      body="$(curl -sS -m 2 -X POST "$NOTES_URL/api/getStatus" -H 'content-type: application/json' --data '{}' || true)"
      if [[ "$body" == *'"service":"notes-service"'* ]]; then
        ready=1
        break
      fi
    fi
    sleep 0.2
  done
  if [[ "$ready" -ne 1 ]]; then
    if kill -0 "$PID" 2>/dev/null; then
      kill "$PID" 2>/dev/null || true
      wait "$PID" 2>/dev/null || true
    fi
    die "server did not become usable on $NOTES_URL; see $logfile"
  fi
  printf 'export NOTES_VERIFY_RUN=%q\n' "$RUN_ID"
  printf 'NOTES_URL=%s\n' "$NOTES_URL"
  printf 'EVIDENCE_DIR=%s\n' "$EVIDENCE_DIR"
  printf 'STATE_DIR=%s\n' "$STATE_DIR"
  printf 'PID=%s\n' "$PID"
}

# ss is not required. Match the listening IPv4 socket in /proc/net/tcp to an fd of this pid.
port_owned_by() {
  local port="$1" pid="$2"
  node -e '
    const { readdirSync, readlinkSync, readFileSync } = require("node:fs")
    const port = Number(process.argv[1])
    const pid = process.argv[2]
    const hex = port.toString(16).toUpperCase().padStart(4, "0")
    const local = "0100007F:" + hex
    const inodes = new Set()
    for (const line of readFileSync("/proc/net/tcp", "utf8").split("\n").slice(1)) {
      const fields = line.trim().split(/\s+/)
      if (fields[1] === local && fields[3] === "0A") inodes.add(fields[9])
    }
    if (inodes.size === 0) process.exit(1)
    let owned = false
    try {
      for (const fd of readdirSync("/proc/" + pid + "/fd")) {
        let target = ""
        try { target = readlinkSync("/proc/" + pid + "/fd/" + fd) } catch { continue }
        const match = /^socket:\[(\d+)\]$/.exec(target)
        if (match && inodes.has(match[1])) owned = true
      }
    } catch {
      process.exit(1)
    }
    process.exit(owned ? 0 : 1)
  ' "$port" "$pid"
}

cmd_doctor() {
  take_run_flag "$@"
  load_run
  require_node
  local ok=1
  local report="$EVIDENCE_DIR/doctor.txt"
  : >"$report"
  note() {
    printf '%s\n' "$*" | tee -a "$report"
  }
  if kill -0 "$PID" 2>/dev/null; then
    note "ok process $PID"
  else
    note "fail process $PID is not running"
    ok=0
  fi
  local cmdline
  cmdline="$(tr '\0' ' ' <"/proc/$PID/cmdline" 2>/dev/null || true)"
  if [[ "$cmdline" == *"examples/notes-service/src/server.ts"* ]]; then
    note "ok cmdline examples/notes-service/src/server.ts"
  else
    note "fail cmdline does not name examples/notes-service/src/server.ts ($cmdline)"
    ok=0
  fi
  if port_owned_by "$PORT" "$PID"; then
    note "ok port $NOTES_URL owned by $PID"
  else
    note "fail port $PORT is not owned by $PID"
    ok=0
  fi
  local health_body health_code
  health_code="$(curl -sS -m 5 -o "$STATE_DIR/healthz.body" -w '%{http_code}' "$NOTES_URL/healthz" || true)"
  health_body="$(cat "$STATE_DIR/healthz.body" 2>/dev/null || true)"
  if [[ "$health_code" == "200" && "$health_body" == "ok" ]]; then
    note "ok healthz 200 ok"
  else
    note "fail healthz code=$health_code body=$health_body"
    ok=0
  fi
  local status_body status_code
  status_code="$(curl -sS -m 5 -o "$STATE_DIR/status.body" -w '%{http_code}' -X POST "$NOTES_URL/api/getStatus" -H 'content-type: application/json' --data '{}' || true)"
  status_body="$(cat "$STATE_DIR/status.body" 2>/dev/null || true)"
  if [[ "$status_code" == "200" ]] && printf '%s' "$status_body" | node -e 'const j=JSON.parse(require("fs").readFileSync(0,"utf8")); if(j.service!=="notes-service"||typeof j.notes!=="number") process.exit(1)'; then
    note "ok getStatus $status_body"
  else
    note "fail getStatus code=$status_code body=$status_body"
    ok=0
  fi
  local who_body who_code
  who_code="$(curl -sS -m 5 -o "$STATE_DIR/whoami.body" -w '%{http_code}' -X POST "$NOTES_URL/api/whoAmI" -H 'content-type: application/json' -H 'authorization: Bearer ada' --data '{}' || true)"
  who_body="$(cat "$STATE_DIR/whoami.body" 2>/dev/null || true)"
  if [[ "$who_code" == "200" && "$who_body" == *'"id":"ada"'* && "$who_body" == *'"notes:write"'* ]]; then
    note "ok whoAmI $who_body"
  else
    note "fail whoAmI code=$who_code body=$who_body"
    ok=0
  fi
  local version
  version="$(cd "$ROOT" && node --import tsx examples/notes-service/src/cli.ts --version 2>"$STATE_DIR/version.err" || true)"
  if [[ "$version" == "notes v1.0.0" ]]; then
    note "ok cli notes v1.0.0"
  else
    note "fail cli version [$version]"
    ok=0
  fi
  if [[ "$ok" -eq 1 ]]; then
    note "doctor ok $NOTES_URL"
    return 0
  fi
  note "doctor failed"
  return 1
}

cmd_http() {
  take_run_flag "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"
  load_run
  local token="ada" evidence="" method="" path="" data=""
  local -a headers=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --token)
        token="$2"
        shift 2
        ;;
      --evidence)
        evidence="$2"
        shift 2
        ;;
      --header)
        headers+=("$2")
        shift 2
        ;;
      --data)
        data="$2"
        shift 2
        ;;
      POST | GET)
        method="$1"
        path="${2:-}"
        shift 2 || true
        ;;
      *)
        die "unknown http argument: $1"
        ;;
    esac
  done
  [[ -n "$method" && "$path" == /* ]] || die "http needs METHOD and an absolute PATH"
  if [[ -z "$data" ]]; then
    data='{}'
  fi
  local hdr="$STATE_DIR/http.headers" body="$STATE_DIR/http.body"
  local -a curl_args=(-sS -m 20 -D "$hdr" -o "$body" -w '%{http_code}' -X "$method" "$NOTES_URL$path" -H 'content-type: application/json')
  if [[ "$token" != "none" ]]; then
    curl_args+=(-H "authorization: Bearer $token")
  fi
  local header
  for header in "${headers[@]+"${headers[@]}"}"; do
    curl_args+=(-H "$header")
  done
  if [[ "$method" == "POST" ]]; then
    curl_args+=(--data "$data")
  fi
  local code
  code="$(curl "${curl_args[@]}")"
  local response
  response="$(cat "$body")"
  printf 'HTTP %s %s %s\n' "$code" "$method" "$path"
  cat "$hdr"
  printf '%s\n' "$response"
  if [[ -n "$evidence" ]]; then
    {
      printf 'HTTP %s %s %s\n' "$code" "$method" "$path"
      if [[ "$token" == "none" ]]; then
        printf 'authorization: (none)\n'
      else
        printf 'authorization: Bearer %s\n' "$token"
      fi
      printf 'data: %s\n' "$data"
      printf -- '--- headers ---\n'
      cat "$hdr"
      printf -- '--- body ---\n'
      printf '%s\n' "$response"
    } >"$EVIDENCE_DIR/$evidence"
  fi
  [[ "$code" =~ ^2 ]]
}

cmd_cli() {
  take_run_flag "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"
  load_run
  require_node
  local token="ada" evidence="" stdin_text="" stdin_file="" expect="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        shift
        break
        ;;
      --token)
        token="$2"
        shift 2
        ;;
      --evidence)
        evidence="$2"
        shift 2
        ;;
      --expect-exit)
        expect="$2"
        shift 2
        ;;
      --stdin-text)
        stdin_text="$2"
        shift 2
        ;;
      --stdin-file)
        stdin_file="$2"
        shift 2
        ;;
      *)
        die "unknown cli argument before --: $1"
        ;;
    esac
  done
  [[ $# -gt 0 ]] || die "cli needs -- COMMAND..."
  [[ -z "$stdin_text" || -z "$stdin_file" ]] || die "pass only one of --stdin-text and --stdin-file"
  local out="$STATE_DIR/cli.stdout" err="$STATE_DIR/cli.stderr"
  local code=0
  run_notes_cli() {
    cd "$ROOT"
    if [[ "$token" == "none" ]]; then
      env -u NOTES_TOKEN NOTES_URL="$NOTES_URL" node --import tsx examples/notes-service/src/cli.ts "$@"
    else
      NOTES_URL="$NOTES_URL" NOTES_TOKEN="$token" node --import tsx examples/notes-service/src/cli.ts "$@"
    fi
  }
  set +e
  if [[ -n "$stdin_text" ]]; then
    printf '%s' "$stdin_text" | run_notes_cli "$@" >"$out" 2>"$err"
  elif [[ -n "$stdin_file" ]]; then
    run_notes_cli "$@" <"$stdin_file" >"$out" 2>"$err"
  else
    run_notes_cli "$@" >"$out" 2>"$err"
  fi
  code=$?
  set -e
  printf 'exit %s\n' "$code"
  printf -- '--- stdout ---\n'
  cat "$out"
  printf -- '--- stderr ---\n'
  cat "$err"
  if [[ -n "$evidence" ]]; then
    {
      printf 'command: notes'
      printf ' %q' "$@"
      printf '\n'
      printf 'token: %s\n' "$token"
      printf 'NOTES_URL: %s\n' "$NOTES_URL"
      printf 'exit: %s\n' "$code"
      printf -- '--- stdout ---\n'
      cat "$out"
      printf -- '--- stderr ---\n'
      cat "$err"
    } >"$EVIDENCE_DIR/$evidence"
  fi
  [[ "$code" -eq "$expect" ]]
}

cmd_cleanup() {
  take_run_flag "$@"
  if [[ -z "${RUN_ID:-}" ]]; then
    die "set NOTES_VERIFY_RUN or pass --run"
  fi
  STATE_DIR="/tmp/effect-actions-verify-$RUN_ID"
  if [[ ! -f "$STATE_DIR/run.env" ]]; then
    printf 'notes-verify: no state at %s\n' "$STATE_DIR"
    return 0
  fi
  # shellcheck disable=SC1090
  source "$STATE_DIR/run.env"
  if [[ -n "${PID:-}" ]] && kill -0 "$PID" 2>/dev/null; then
    kill "$PID" 2>/dev/null || true
    local i
    for i in $(seq 1 25); do
      kill -0 "$PID" 2>/dev/null || break
      sleep 0.2
    done
    if kill -0 "$PID" 2>/dev/null; then
      kill -9 "$PID" 2>/dev/null || true
      wait "$PID" 2>/dev/null || true
    fi
  fi
  local evidence="${EVIDENCE_DIR:-}"
  rm -rf "$STATE_DIR"
  printf 'removed %s\n' "$STATE_DIR"
  if [[ -n "$evidence" ]]; then
    printf 'kept %s\n' "$evidence"
  fi
}

main() {
  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    http) cmd_http "$@" ;;
    cli) cmd_cli "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    -h | --help | help | "") usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
