{
  "name": "@gjermundgaraba/effect-actions",
  "version": "0.21.0",
  "description": "Define Effect action contracts once and project them onto HTTP, MCP, Effect RPC, native Toolkits, and CLIs.",
  "keywords": [
    "ai-agents",
    "cli",
    "effect",
    "effect-ts",
    "http-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rpc",
    "typescript"
  ],
  "homepage": "https://github.com/gjermundgaraba/effect-actions#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/effect-actions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/effect-actions.git"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./Action": "./src/contract/Action.ts",
    "./ActionCli": "./src/cli/ActionCli.ts",
    "./ActionHttp": "./src/http/ActionHttp.ts",
    "./ActionMcp": "./src/mcp/ActionMcp.ts",
    "./ActionRpc": "./src/rpc/ActionRpc.ts",
    "./ActionToolkit": "./src/toolkit/ActionToolkit.ts",
    "./Authentication": "./src/authentication/Authentication.ts",
    "./Event": "./src/contract/Event.ts",
    "./Testing": "./src/testing/Testing.ts",
    "./Webhook": "./src/webhook/Webhook.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./Action": "./dist/Action.mjs",
      "./ActionCli": "./dist/ActionCli.mjs",
      "./ActionHttp": "./dist/ActionHttp.mjs",
      "./ActionMcp": "./dist/ActionMcp.mjs",
      "./ActionRpc": "./dist/ActionRpc.mjs",
      "./ActionToolkit": "./dist/ActionToolkit.mjs",
      "./Authentication": "./dist/Authentication.mjs",
      "./Event": "./dist/Event.mjs",
      "./Testing": "./dist/Testing.mjs",
      "./Webhook": "./dist/Webhook.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && effect-tsgo patch --no-typescript --oxlint",
    "example": "vpx examples/notes-service/src/server.ts",
    "test:package": "vp run -r build && vpx scripts/test-package.ts",
    "docs:sync": "vpx scripts/sync-skill.ts",
    "ready": "vp check && vp test && vp run test:package"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "~4.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
