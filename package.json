{
  "name": "@gjermundgaraba/effect-actions",
  "version": "0.8.0",
  "description": "Define Effect action contracts once and project them onto HTTP, MCP, native Toolkits, and CLIs.",
  "homepage": "https://github.com/gjermundgaraba/effect-actions#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/effect-actions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/effect-actions.git"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./Action": "./dist/Action.mjs",
    "./ActionCli": "./dist/ActionCli.mjs",
    "./ActionHttp": "./dist/ActionHttp.mjs",
    "./ActionMcp": "./dist/ActionMcp.mjs",
    "./ActionToolkit": "./dist/ActionToolkit.mjs",
    "./Authentication": "./dist/Authentication.mjs",
    "./Testing": "./dist/Testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "example": "node --import tsx examples/server.ts",
    "test:package": "vp run build && node scripts/test-package.mjs",
    "docs:sync": "node --import tsx scripts/sync-skill.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.118",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.6.2",
    "effect": "4.0.0-rc.118",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.118 <4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
