{
  "name": "effect-actions-cloudflare-tests",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "PLAIN", "class_name": "Plain" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "EXTENDED", "class_name": "Extended" },
      { "name": "ROUTER_PROVIDED", "class_name": "RouterProvided" },
      { "name": "PREFIXED", "class_name": "Prefixed" },
      { "name": "BROKEN", "class_name": "Broken" },
      { "name": "BROKEN_SERVICES", "class_name": "BrokenServices" },
      { "name": "COUNTED", "class_name": "Counted" },
      { "name": "OWN_SOCKETS", "class_name": "OwnSockets" },
      { "name": "RETRIED", "class_name": "Retried" },
      { "name": "RETRIED_AT_ONCE", "class_name": "RetriedAtOnce" },
      { "name": "HOSTED", "class_name": "Hosted" },
      { "name": "MANUAL", "class_name": "Manual" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Plain",
        "Room",
        "Extended",
        "RouterProvided",
        "Prefixed",
        "Broken",
        "BrokenServices",
        "Counted",
        "OwnSockets",
        "Retried",
        "RetriedAtOnce",
        "Hosted",
        "Manual",
      ],
    },
  ],
}
