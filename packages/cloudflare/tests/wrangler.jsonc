{
  "name": "effect-actions-cloudflare-tests",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  // Why: the runtime's own reply to a client's close is off, as before the date 2026-04-07, so the
  // sockets' tests show the protocol answering the closing handshake itself.
  "compatibility_flags": ["web_socket_manual_reply_to_close"],
  "vars": { "GREETING": "from the deployment" },
  "durable_objects": {
    "bindings": [
      { "name": "PLAIN", "class_name": "Plain" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "EXTENDED", "class_name": "Extended" },
      { "name": "ROUTER_PROVIDED", "class_name": "RouterProvided" },
      { "name": "PREFIXED", "class_name": "Prefixed" },
      { "name": "BROKEN", "class_name": "Broken" },
      { "name": "BROKEN_SERVICES", "class_name": "BrokenServices" },
      { "name": "COUNTED", "class_name": "Counted" },
      { "name": "OWN_SOCKETS", "class_name": "OwnSockets" },
      { "name": "RETRIED", "class_name": "Retried" },
      { "name": "RETRIED_AT_ONCE", "class_name": "RetriedAtOnce" },
      { "name": "HOSTED", "class_name": "Hosted" },
      { "name": "PLUGIN_HOST", "class_name": "PluginHost" },
      { "name": "PANE_HOST", "class_name": "PaneHost" },
      { "name": "STUBBED", "class_name": "Stubbed" },
      { "name": "STREAMED", "class_name": "Streamed" },
      { "name": "NATIVE", "class_name": "Native" },
      { "name": "RACED", "class_name": "Raced" },
      { "name": "BUILT_AGAIN_RACED", "class_name": "BuiltAgainRaced" },
      { "name": "LATCHED_RACED", "class_name": "LatchedRaced" },
      { "name": "UNSERVED", "class_name": "Unserved" },
      { "name": "FROM_ENV", "class_name": "FromEnv" },
      { "name": "DELEGATING", "class_name": "Delegating" },
      { "name": "FAILING", "class_name": "Failing" },
      { "name": "VERSIONED", "class_name": "Versioned" },
      { "name": "WATCHING", "class_name": "Watching" },
      { "name": "HOOKING", "class_name": "Hooking" },
      { "name": "SHELF", "class_name": "Shelf" },
      { "name": "TASKED", "class_name": "Tasked" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Plain",
        "Room",
        "Extended",
        "RouterProvided",
        "Prefixed",
        "Broken",
        "BrokenServices",
        "Counted",
        "OwnSockets",
        "Retried",
        "RetriedAtOnce",
        "Hosted",
        "PluginHost",
        "PaneHost",
        "Stubbed",
        "Streamed",
        "Native",
        "Raced",
        "BuiltAgainRaced",
        "LatchedRaced",
        "Unserved",
        "FromEnv",
        "Delegating",
        "Failing",
        "Versioned",
        "Watching",
        "Hooking",
        "Shelf",
        "Tasked",
      ],
    },
  ],
}
