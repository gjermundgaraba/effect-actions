{
  "name": "chat-rooms",
  "main": "./src/worker.ts",
  // The runtime replies to a client's close frame itself from 2026-04-07, which
  // ActionDurableObject.layerWebSocket relies on.
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
}
