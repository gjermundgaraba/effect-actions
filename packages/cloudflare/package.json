{
  "name": "@gjermundgaraba/effect-actions-cloudflare",
  "version": "0.34.0",
  "description": "Run effect-actions entities on Cloudflare Durable Objects through Effect Cluster.",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "effect",
    "effect-cluster",
    "effect-ts",
    "workers"
  ],
  "homepage": "https://github.com/gjermundgaraba/effect-actions/tree/main/packages/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/effect-actions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/effect-actions.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ActionCluster": "./src/cluster/ActionCluster.ts",
    "./ActionClusterEntity": "./src/host/ActionClusterEntity.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./ActionCluster": "./dist/ActionCluster.mjs",
      "./ActionClusterEntity": "./dist/ActionClusterEntity.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-cloudflare": "catalog:",
    "@effect/vitest": "catalog:",
    "@gjermundgaraba/effect-actions": "workspace:*",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-cloudflare": "~4.1.4",
    "@gjermundgaraba/effect-actions": "workspace:^",
    "effect": "~4.1.4"
  }
}
